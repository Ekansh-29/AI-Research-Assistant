# Copy this file to ".env" and fill in your values.
# .env is git-ignored, so your keys never reach GitHub.

# ---- LLM -------------------------------------------------------------
# "groq" (free hosted API) or "ollama" (runs on your laptop)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OLLAMA_MODEL=qwen3:8b

# ---- Vector database (Qdrant) ---------------------------------------
# Fill these to use Qdrant Cloud. Leave QDRANT_URL empty to use a local folder.
QDRANT_URL=
QDRANT_API_KEY=

# Must be a model your cluster offers (Qdrant Cloud -> your cluster -> Inference tab)
# and EMBEDDING_DIM must match that model's size.
EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
EMBEDDING_DIM=384

# ---- Security --------------------------------------------------------
# Password for uploading/deleting. Leave empty on your laptop, ALWAYS set it on Render.
ADMIN_TOKEN=
